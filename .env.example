# ---------- Google Sheets ----------
SPREADSHEET_ID=the_long_id_from_your_google_sheets_url
WORKSHEET_NAME=closing
LEADS_RAW_WORKSHEET=leads
FINANCE_SHEET=finance
# Local: path to the service account JSON key
SERVICE_ACCOUNT_JSON_PATH=service_account.json
